# ==============================================================================
# 2025HUAT - FSD 自动驾驶系统本地环境变量示例模板 (.env.example)
#
# 使用方式:
#   cp .env.example .env
#   根据本机环境调整变量值（.env 已被 .gitignore 忽略，不会提交到仓库）
# ==============================================================================

# ROS 工作区与回放配置
CATKIN_WS="${HOME}/coding/FSAC/2025"
ROS_DISTRO="noetic"

# 默认回放 Rosbag 路径与速率 (可替换为您本地的测试包路径)
DEFAULT_BAG_PATH="${HOME}/rosbag/track.bag"
DEFAULT_PLAY_RATE="1.0"

# 默认任务模式 (trackdrive | skidpad | acceleration | autocross)
DEFAULT_MISSION="trackdrive"

# 默认定位后端 (mapper | factor_graph)
LOCALIZATION_BACKEND="mapper"

# 视觉输入配置
VISION_MODE="standard"
VISION_IMPL="py"
VISION_IMAGE_TOPIC="/resize_img_out"

# 性能测试输出目录
PERF_OUTPUT_DIR="/tmp/fsd_perf_output"
