<!--
  Mission stack composition for standard real/sim missions.
  This launch centralizes subsystem wiring and tools to reduce cross-file duplication.
-->
<launch>
    <arg name="simulation" default="false"/>

    <arg name="perception_mode" default="track"/>
    <arg name="localization_mode" default="track"/>
    <arg name="backend" default="mapper"/>
    <arg name="publish_dual_backends" default="false"/>
    <arg name="fg_carstate_topic" default="localization/fg/car_state"/>
    <arg name="mapper_carstate_topic" default="localization/mapper/car_state"/>
    <arg name="fg_shadow_mode" default="true"/>
    <arg name="fg_mainline_enable_mapper_fallback" default="true"/>
    <arg name="planner" default="unified"/>
    <arg name="planning_mission" default="high_speed"/>
    <arg name="control_mode_profile" default="track"/>
    <arg name="control_mode" default="4"/>
    <arg name="decision_fusion_budget_sec" default="0.15"/>
    <arg name="enable_perception" default="true"/>
    <arg name="enable_vision" default="true" doc="Enable camera-based vision module"/>
    <arg name="enable_localization" default="true"/>
    <arg name="enable_planning" default="true"/>
    <arg name="enable_control" default="true"/>

    <arg name="vision_mode" default="standard" doc="standard | lightweight | fallback_only"/>
    <arg name="vision_impl" default="py" doc="py | cpp"/>
    <arg name="vision_image_topic" default="/camera/image_raw"/>
    <arg name="vision_model_path" default="$(find vision_ros)/models/yolo26l_48g/weights/best.pt"/>
    <arg name="vision_require_model" default="true"/>
    <arg name="vision_debug" default="false"/>

    <arg name="vehicle" default="A13"/>
    <arg name="perception_vehicle_config" default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/perception.yaml"/>
    <arg name="perception_vehicle_local_config" default=""/>
    <arg name="localization_vehicle_config" default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/localization.yaml"/>
    <arg name="localization_vehicle_local_config" default=""/>
    <arg name="control_vehicle_config" default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/control.yaml"/>
    <arg name="control_vehicle_local_config" default=""/>
    <arg name="planning_vehicle_config" default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/planning.yaml"/>
    <arg name="planning_vehicle_local_config" default=""/>
    <arg name="vision_vehicle_config" default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/vision.yaml"/>
    <arg name="vision_vehicle_local_config" default=""/>

    <arg name="perception_mission_config" default=""/>
    <arg name="localization_mission_config" default=""/>
    <arg name="control_mission_config" default=""/>

    <arg name="cmd_topic" default="vehicle/cmd"/>
    <arg name="carstate_topic" default="localization/car_state"/>
    <arg name="decision_cone_topic" default="perception/decision/detections"/>
    <arg name="mainline_cone_topic" default="perception/decision/detections"/>
    <arg name="pathlimits_topic" default="planning/pathlimits"/>
    <arg name="pathlimits_v2_topic" default="planning/pathlimits_v2"/>
    <arg name="planning_enable_pathlimits_v1_publish" default="true"/>
    <arg name="planning_enable_pathlimits_v2_publish" default="true"/>
    <arg name="control_pathlimits_v2_topic" default="$(arg pathlimits_v2_topic)"/>
    <arg name="control_enable_pathlimits_v1_subscribe" default="true"/>
    <arg name="control_enable_pathlimits_v2_subscribe" default="false"/>
    <arg name="control_prefer_pathlimits_v2" default="false"/>
    <arg name="control_enable_pathlimits_v2_auto_fallback" default="true"/>
    <arg name="control_pathlimits_source_stale_timeout_sec" default="-1.0"/>
    <arg name="approaching_goal_topic" default="planning/skidpad/approaching_goal"/>

    <!-- ========== Tools args ========== -->
    <arg name="bag" default=""/>
    <arg name="rate" default="1.0"/>
    <arg name="loop" default="false"/>
    <arg name="launch_rviz" default="true"/>
    <arg name="launch_viz" default="true"/>
    <arg name="rviz_mode" default="dual"/>
    <arg name="rviz_config" default="high_speed"/>
    <arg name="viz_cone_topic" default="perception/lidar_cluster/detections"/>
    <arg name="viz_fused_cone_topic" default="perception/fusion/detections"/>
    <arg name="viz_prefer_fused_detections" default="true"/>
    <arg name="viz_unmatched_as_white" default="true"/>
    <arg name="viz_fused_stale_timeout_sec" default="0.35"/>
    <arg name="fleet_config" default="$(find fsd_launch)/config/vehicle_fleet.yaml"/>
    <arg name="enable_static_tf" default="true"/>

    <!-- ========== Global Config ========== -->
    <param name="/use_sim_time" value="$(arg simulation)"/>
    <rosparam command="load" file="$(arg fleet_config)" ns="vehicle_fleet"/>

    <!-- Vehicle geometry: 统一真值源，在子系统之前加载 -->
    <arg name="vehicle_geometry_config"
         default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/vehicle_geometry.yaml"/>
    <rosparam command="load" file="$(arg vehicle_geometry_config)"/>

    <!-- ========== Simulation bag validation ========== -->
    <group if="$(arg simulation)">
        <group unless="$(eval bag != '')">
            <node pkg="rospy" type="message" name="error_check" output="screen"
                  args="错误：仿真模式必须指定bag文件路径！使用参数 bag:=/path/to/bag.bag"/>
        </group>
    </group>

    <!-- ========== Subsystems ========== -->
    <include if="$(arg enable_perception)" file="$(find fsd_launch)/launch/subsystems/perception.launch">
        <arg name="simulation" value="$(arg simulation)"/>
        <arg name="launch_rviz" value="false"/>
        <arg name="mode" value="$(arg perception_mode)"/>
        <arg name="carstate_topic" value="$(arg carstate_topic)"/>
        <arg name="decision_cone_topic" value="$(arg decision_cone_topic)"/>
        <arg name="decision_fusion_budget_sec" value="$(arg decision_fusion_budget_sec)"/>
        <arg name="mission_config" value="$(arg perception_mission_config)"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="vehicle_config" value="$(arg perception_vehicle_config)"/>
        <arg name="vehicle_local_config" value="$(arg perception_vehicle_local_config)"/>
    </include>

    <!-- Vision (optional, parallel to LiDAR perception) -->
    <include if="$(arg enable_vision)"
             file="$(find fsd_launch)/launch/subsystems/vision.launch">
        <arg name="simulation" value="$(arg simulation)"/>
        <arg name="mission" value="$(arg perception_mode)"/>
        <arg name="mode" value="$(arg vision_mode)"/>
        <arg name="impl" value="$(arg vision_impl)"/>
        <arg name="debug" value="$(arg vision_debug)"/>
        <arg name="image_topic" value="$(arg vision_image_topic)"/>
        <arg name="model_path" value="$(arg vision_model_path)"/>
        <arg name="require_model" value="$(arg vision_require_model)"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="vehicle_config" value="$(arg vision_vehicle_config)"/>
        <arg name="vehicle_local_config" value="$(arg vision_vehicle_local_config)"/>
    </include>

    <include if="$(arg enable_localization)" file="$(find fsd_launch)/launch/subsystems/localization.launch">
        <arg name="mode" value="$(arg localization_mode)"/>
        <arg name="carstate_topic" value="$(arg carstate_topic)"/>
        <arg name="cone_topic" value="$(arg mainline_cone_topic)"/>
        <arg name="backend" value="$(arg backend)"/>
        <arg name="publish_dual_backends" value="$(arg publish_dual_backends)"/>
        <arg name="fg_carstate_topic" value="$(arg fg_carstate_topic)"/>
        <arg name="mapper_carstate_topic" value="$(arg mapper_carstate_topic)"/>
        <arg name="fg_shadow_mode" value="$(arg fg_shadow_mode)"/>
        <arg name="fg_mainline_enable_mapper_fallback" value="$(arg fg_mainline_enable_mapper_fallback)"/>
        <arg name="mission_config" value="$(arg localization_mission_config)"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="vehicle_config" value="$(arg localization_vehicle_config)"/>
        <arg name="vehicle_local_config" value="$(arg localization_vehicle_local_config)"/>
    </include>

    <include if="$(arg enable_planning)" file="$(find fsd_launch)/launch/subsystems/planning.launch">
        <arg name="planner" value="$(arg planner)"/>
        <arg name="mission" value="$(arg planning_mission)"/>
        <arg name="output_pathlimits_topic" value="$(arg pathlimits_topic)"/>
        <arg name="output_pathlimits_v2_topic" value="$(arg pathlimits_v2_topic)"/>
        <arg name="enable_pathlimits_v1_publish" value="$(arg planning_enable_pathlimits_v1_publish)"/>
        <arg name="enable_pathlimits_v2_publish" value="$(arg planning_enable_pathlimits_v2_publish)"/>
        <arg name="input_car_state_topic" value="$(arg carstate_topic)"/>
        <arg name="input_cone_topic" value="$(arg mainline_cone_topic)"/>
        <arg name="output_approaching_goal_topic" value="$(arg approaching_goal_topic)"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="vehicle_config" value="$(arg planning_vehicle_config)"/>
        <arg name="vehicle_local_config" value="$(arg planning_vehicle_local_config)"/>
    </include>

    <group if="$(arg enable_control)">
        <include file="$(find fsd_launch)/launch/subsystems/control.launch">
            <arg name="mode" value="$(arg control_mode_profile)"/>
            <arg name="control_mode" value="$(arg control_mode)"/>
            <arg name="cmd_topic" value="$(arg cmd_topic)"/>
            <arg name="pathlimits_topic" value="$(arg pathlimits_topic)"/>
            <arg name="pathlimits_v2_topic" value="$(arg control_pathlimits_v2_topic)"/>
            <arg name="enable_pathlimits_v1_subscribe" value="$(arg control_enable_pathlimits_v1_subscribe)"/>
            <arg name="enable_pathlimits_v2_subscribe" value="$(arg control_enable_pathlimits_v2_subscribe)"/>
            <arg name="prefer_pathlimits_v2" value="$(arg control_prefer_pathlimits_v2)"/>
            <arg name="enable_pathlimits_v2_auto_fallback" value="$(arg control_enable_pathlimits_v2_auto_fallback)"/>
            <arg name="pathlimits_source_stale_timeout_sec" value="$(arg control_pathlimits_source_stale_timeout_sec)"/>
            <arg name="carstate_topic" value="$(arg carstate_topic)"/>
            <arg name="approaching_goal_topic" value="$(arg approaching_goal_topic)"/>
            <arg name="mission_config" value="$(arg control_mission_config)"/>
            <arg name="vehicle" value="$(arg vehicle)"/>
            <arg name="vehicle_config" value="$(arg control_vehicle_config)"/>
            <arg name="vehicle_local_config" value="$(arg control_vehicle_local_config)"/>
        </include>

        <include unless="$(arg simulation)" file="$(find fsd_launch)/launch/subsystems/vehicle.launch">
            <arg name="cmd_topic" value="$(arg cmd_topic)"/>
        </include>
    </group>
    <!-- ========== Tools ========== -->
    <!-- Rosbag Player (仿真模式) -->
    <include if="$(arg simulation)" file="$(find fsd_launch)/launch/tools/rosbag_play.launch">
        <arg name="bag" value="$(arg bag)"/>
        <arg name="rate" value="$(arg rate)"/>
        <arg name="loop" value="$(arg loop)"/>
    </include>

    <!-- Static TF: base_link -> velodyne -->
    <node if="$(arg enable_static_tf)" pkg="tf2_ros" type="static_transform_publisher"
          name="base_link_to_velodyne" args="0 0 0 0 0 0 base_link velodyne"/>

    <!-- FSD Visualization Node -->
    <include if="$(arg launch_viz)" file="$(find fsd_visualization)/launch/visualization.launch">
        <arg name="frame_id" value="world"/>
        <arg name="show_trail" value="true"/>
        <arg name="use_mesh" value="false"/>
        <arg name="cone_topic" value="$(arg viz_cone_topic)"/>
        <arg name="fused_cone_topic" value="$(arg viz_fused_cone_topic)"/>
        <arg name="prefer_fused_detections" value="$(arg viz_prefer_fused_detections)"/>
        <arg name="unmatched_as_white" value="$(arg viz_unmatched_as_white)"/>
        <arg name="fused_stale_timeout_sec" value="$(arg viz_fused_stale_timeout_sec)"/>
    </include>

    <!-- RViz -->
    <include if="$(arg launch_rviz)" file="$(find fsd_launch)/launch/tools/rviz.launch">
        <arg name="config" value="$(arg rviz_config)"/>
        <arg name="enable_viz_node" value="false"/>
        <arg name="mode" value="$(arg rviz_mode)"/>
    </include>
</launch>
