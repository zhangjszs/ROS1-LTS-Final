<!--
  FSD Localization Subsystem
  定位子系统：KD-tree 定位、状态估计
-->
<launch>
    <arg name="use_eskf" default="false" doc="使用 ESKF 滤波器"/>
    <arg name="mode" default="track" doc="赛道模式: accel | skidpad | track"/>
    <arg name="carstate_topic" default="localization/car_state" doc="定位输出车辆状态话题（canonical）"/>
    <arg name="cone_topic" default="perception/lidar_cluster/detections" doc="定位输入锥桶话题"/>
    <arg name="backend" default="mapper" doc="定位后端: mapper (默认) | factor_graph (因子图)"/>
    <arg name="publish_dual_backends" default="false" doc="是否同时发布两个后端的定位结果"/>
    <arg name="fg_carstate_topic" default="localization/fg/car_state" doc="因子图后端输出话题"/>
    <arg name="mapper_carstate_topic" default="localization/mapper/car_state" doc="传统Mapper后端输出话题"/>
    <arg name="fg_shadow_mode" default="true" doc="FG是否仅影子模式运行（true=仅对比，不切主）"/>
    <arg name="fg_mainline_enable_mapper_fallback" default="true" doc="FG主链模式下不可用时是否回退mapper输出"/>
    <arg name="mission_config" default="" doc="任务级参数覆盖文件（mission overlay）"/>
    <arg name="vehicle" default="A13" doc="车辆型谱ID"/>
    <arg name="vehicle_config" default="$(find fsd_launch)/config/vehicles/$(arg vehicle)/localization.yaml"/>
    <arg name="vehicle_local_config" default="" doc="本地覆盖参数文件（*.local.yaml）"/>
    <arg name="diagnostics_topic" default="localization/diagnostics" doc="定位入口诊断本地话题"/>
    <arg name="publish_global_diagnostics" default="true" doc="定位是否发布到统一 /diagnostics"/>
    <arg name="global_diagnostics_topic" default="/diagnostics" doc="定位统一诊断总线话题"/>
    <arg name="diagnostics_rate_hz" default="1.0" doc="定位入口诊断发布频率"/>

    <!-- Vehicle profile overlay (global ns; location/state_estimator 均可读取) -->
    <rosparam command="load" file="$(arg vehicle_config)"/>
    <rosparam if="$(eval arg('vehicle_local_config') != '')" command="load" file="$(arg vehicle_local_config)"/>

    <!-- Location KD-Tree -->
    <group>
        <include unless="$(arg use_eskf)" file="$(find localization_ros)/launch/location.launch">
            <arg name="mode" value="$(arg mode)"/>
            <arg name="carstate_topic" value="$(arg carstate_topic)"/>
            <arg name="cone_topic" value="$(arg cone_topic)"/>
            <arg name="extra_config" value="$(arg mission_config)"/>
            <arg name="bag" value=""/>
            <arg name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
            <arg name="publish_global_diagnostics" value="$(arg publish_global_diagnostics)"/>
            <arg name="global_diagnostics_topic" value="$(arg global_diagnostics_topic)"/>
            <arg name="diagnostics_rate_hz" value="$(arg diagnostics_rate_hz)"/>
            <arg name="backend" value="$(arg backend)"/>
            <arg name="publish_dual_backends" value="$(arg publish_dual_backends)"/>
            <arg name="fg_carstate_topic" value="$(arg fg_carstate_topic)"/>
            <arg name="mapper_carstate_topic" value="$(arg mapper_carstate_topic)"/>
            <arg name="fg_shadow_mode" value="$(arg fg_shadow_mode)"/>
            <arg name="fg_mainline_enable_mapper_fallback" value="$(arg fg_mainline_enable_mapper_fallback)"/>
        </include>
    </group>

    <!-- Location ESKF (可选) -->
    <include if="$(arg use_eskf)" file="$(find localization_ros)/launch/location_eskf.launch">
        <arg name="mode" value="$(arg mode)"/>
        <arg name="carstate_topic" value="$(arg carstate_topic)"/>
        <arg name="extra_config" value="$(arg mission_config)"/>
        <arg name="bag" value=""/>
    </include>
</launch>
