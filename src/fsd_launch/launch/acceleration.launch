<!--
  FSD Acceleration Mission - 加速赛

  用法:
    roslaunch fsd_launch acceleration.launch
    roslaunch fsd_launch acceleration.launch simulation:=true bag:=/path/to/bag.bag
-->
<launch>
    <!-- ========== Arguments ========== -->
    <arg name="simulation" default="false" doc="仿真模式"/>
    <arg name="bag" default="" doc="Rosbag 路径（仿真模式必填）"/>
    <arg name="rate" default="1.0" doc="回放速率"/>
    <arg name="loop" default="false" doc="rosbag 是否循环播放"/>
    <arg name="launch_rviz" default="true" doc="启动 RViz"/>
    <arg name="launch_viz" default="true" doc="启动可视化节点"/>
    <arg name="rviz_mode" default="dual" doc="RViz模式: main/global/pointcloud/dual"/>
    <arg name="vehicle" default="A13" doc="车辆型谱ID"/>
    <arg name="control_mode" default="1" doc="控制模式: 1(accel)/2(line)/3(skidpad)/4(track)"/>
    <arg name="decision_fusion_budget_sec" default="0.10" doc="统一主链路融合等待预算"/>
    <arg name="enable_vision" default="true" doc="启用视觉模块"/>
    <arg name="vision_mode" default="standard" doc="视觉模式: standard/lightweight/fallback_only"/>
    <arg name="vision_impl" default="py" doc="视觉实现: py/cpp"/>
    <arg name="vision_image_topic" default="/camera/image_raw" doc="视觉输入图像话题"/>
    <arg name="vision_model_path" default="$(find vision_ros)/models/exp26l_gpu/best.onnx" doc="视觉模型路径"/>
    <arg name="vision_require_model" default="true" doc="缺模型时是否fail-fast"/>
    <arg name="vision_debug" default="false" doc="视觉调试图像"/>

    <include file="$(find fsd_launch)/launch/subsystems/mission_stack.launch">
        <arg name="simulation" value="$(arg simulation)"/>
        <arg name="bag" value="$(arg bag)"/>
        <arg name="rate" value="$(arg rate)"/>
        <arg name="loop" value="$(arg loop)"/>
        <arg name="launch_rviz" value="$(arg launch_rviz)"/>
        <arg name="launch_viz" value="$(arg launch_viz)"/>
        <arg name="rviz_mode" value="$(arg rviz_mode)"/>
        <arg name="rviz_config" value="line"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="perception_mode" value="accel"/>
        <arg name="localization_mode" value="accel"/>
        <arg name="planning_mission" value="acceleration"/>
        <arg name="control_mode_profile" value="accel"/>
        <arg name="control_mode" value="$(arg control_mode)"/>
        <arg name="decision_fusion_budget_sec" value="$(arg decision_fusion_budget_sec)"/>
        <arg name="enable_vision" value="$(arg enable_vision)"/>
        <arg name="vision_mode" value="$(arg vision_mode)"/>
        <arg name="vision_impl" value="$(arg vision_impl)"/>
        <arg name="vision_image_topic" value="$(arg vision_image_topic)"/>
        <arg name="vision_model_path" value="$(arg vision_model_path)"/>
        <arg name="vision_require_model" value="$(arg vision_require_model)"/>
        <arg name="vision_debug" value="$(arg vision_debug)"/>
    </include>
</launch>
