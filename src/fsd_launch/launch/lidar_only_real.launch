<!--
  LiDAR Only preset (real vehicle).
  Only starts LiDAR perception. No localization, no vision, no planning, no control.
  Use for perception/point-cloud debugging on real vehicle.

  Usage:
    roslaunch fsd_launch lidar_only_real.launch
    roslaunch fsd_launch lidar_only_real.launch perception_mode:=accel
-->
<launch>
    <arg name="vehicle" default="A13"/>
    <arg name="launch_rviz" default="false"/>
    <arg name="launch_viz" default="false"/>
    <arg name="rviz_mode" default="pointcloud"/>
    <arg name="perception_mode" default="track" doc="赛道模式: accel | skidpad | track"/>

    <include file="$(find fsd_launch)/launch/subsystems/mission_stack.launch">
        <arg name="simulation" value="false"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="launch_rviz" value="$(arg launch_rviz)"/>
        <arg name="launch_viz" value="$(arg launch_viz)"/>
        <arg name="rviz_mode" value="$(arg rviz_mode)"/>
        <arg name="perception_mode" value="$(arg perception_mode)"/>
        <arg name="enable_perception" value="true"/>
        <arg name="enable_vision" value="false"/>
        <arg name="enable_localization" value="false"/>
        <arg name="enable_planning" value="false"/>
        <arg name="enable_control" value="false"/>
    </include>
</launch>
